---
import { CH1 } from "../../content/zh-chapters/ch01";
const chapter = CH1;
const base = "/rl-field-guide";
---

<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{chapter.title} · 强化学习指南</title>
</head>
<body>
  <div style="max-width:680px;margin:0 auto;padding:40px 24px 80px;font-family:Georgia,'Noto Serif SC',serif;line-height:1.95;color:#1a1d2e">
    <p style="font-family:monospace;font-size:11px;letter-spacing:.3em;color:#a85c04">第 1 部分 · 认识问题</p>
    <h1 style="font-size:clamp(28px,4vw,40px);font-weight:800;margin:8px 0 12px;letter-spacing:-.02em">{chapter.title}</h1>
    <p style="color:#66706b;font-size:16px">{chapter.intro}</p>
    <div style="margin-top:32px" set:html={chapter.content.split("\n\n").map(b => {
      if (b.startsWith("## ")) return `<h2>${b.slice(3)}</h2>`;
      return `<p>${b}</p>`;
    }).join("")} />
    <nav style="display:flex;justify-content:space-between;margin-top:48px;padding-top:20px;border-top:1px solid #dfe4e1">
      <span></span>
      <a href={`${base}/zh/`} style="color:#a85c04;font-weight:600;text-decoration:none">返回目录 →</a>
    </nav>
  </div>
</body>
</html>
