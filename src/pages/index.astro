---
import GuideLayout from "@/layouts/GuideLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<GuideLayout title="RL Field Guide" description="A complete, example-first reinforcement learning reading course in English." language="en" canonicalPath={`${base}/`}>
  <main id="main-content" class="language-gate" tabindex="-1">
    <div class="language-gate-card">
      <span class="guide-brand-mark" aria-hidden="true">RL</span>
      <p class="instrument-label">RL FIELD GUIDE · 46 CHAPTERS · 9 PARTS</p>
      <h1>Learn reinforcement learning as a chain of decisions and evidence.</h1>
      <p>The course begins before algorithms, works through visible examples and equations, and ends with modern language-model post-training and deployment evidence.</p>
      <div class="language-gate-actions single-action">
        <a class="primary-link" href={`${base}/en/`}>Open the complete English course <span>→</span></a>
      </div>
    </div>
  </main>
</GuideLayout>
