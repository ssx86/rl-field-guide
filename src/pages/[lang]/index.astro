---
import GuideHeader from "@/components/GuideHeader.astro";
import LearningLoopVisual from "@/components/LearningLoopVisual.astro";
import MethodMap from "@/components/MethodMap.astro";
import { CURRICULUM, PARTS } from "@/content/curriculum";
import GuideLayout from "@/layouts/GuideLayout.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }];
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeHref = `${base}/en/`;
const startHref = `${base}/en/learn/${CURRICULUM[0].slug}/`;
const partRows = PARTS.map((part) => ({ ...part, chapters: CURRICULUM.filter((chapter) => chapter.part === part.id) }));
---

<GuideLayout title="RL Field Guide · A complete reading course" description="A 46-chapter, example-first field guide to reinforcement learning from sequential decisions through modern language-model post-training." language="en" canonicalPath={homeHref}>
  <GuideHeader language="en" brand="RL FIELD GUIDE" homeHref={homeHref} themeLabel="Switch color theme" />

  <main id="main-content" class="course-home" tabindex="-1">
    <section class="course-hero">
      <div class="course-hero-copy">
        <p class="instrument-label">Zero-start · 46 chapters · 9 parts</p>
        <h1>A field guide to reinforcement learning</h1>
        <p class="course-strapline">Begin with the decision. Watch the evidence move. Name the method only after its job is visible.</p>
        <p class="course-intro">This is a reading course, not a stack of slides and not a catalog of acronyms. Every chapter connects to the previous question, begins with a concrete situation, works through numbers or procedure, introduces notation after its quantities have jobs, and ends by showing where the conclusion stops working.</p>
        <div class="hero-actions">
          <a class="primary-link" href={startHref}>Start with the problem<span>→</span></a>
          <a class="text-link" href="#course-route">See the complete field map<span>↓</span></a>
        </div>
        <div class="course-promises" aria-label="Reading contract">
          <strong>Reading contract</strong>
          <ul>
            <li>Continuous prose before terminology</li>
            <li>One semantic diagram and one worked example per chapter</li>
            <li>Equations tied back to visible quantities</li>
            <li>Counterexamples, boundaries, and original sources</li>
          </ul>
        </div>
      </div>
      <LearningLoopVisual language="en" />
    </section>

    <section class="method-section" aria-labelledby="method-title">
      <div class="section-heading">
        <p class="instrument-label">01 · How to read</p>
        <h2 id="method-title">Use the same evidence loop in every chapter</h2>
      </div>
      <div class="method-layout">
        <ol class="method-steps">
          <li><span>01</span><div><h3>Predict</h3><p>Commit to what you expect before the explanation makes the answer feel obvious.</p></div></li>
          <li><span>02</span><div><h3>Trace</h3><p>Follow the state, action, feedback, and next consequence through one concrete case.</p></div></li>
          <li><span>03</span><div><h3>Calculate</h3><p>Reproduce the numeric target or procedural decision with every intermediate step visible.</p></div></li>
          <li><span>04</span><div><h3>Name</h3><p>Attach terminology and notation only after the mechanism already has meaning.</p></div></li>
          <li><span>05</span><div><h3>Break</h3><p>Test the boundary with a counterexample, missing assumption, or unsupported state.</p></div></li>
        </ol>
        <MethodMap language="en" />
      </div>
    </section>

    <section id="course-route" class="route-section" aria-labelledby="route-title">
      <div class="section-heading route-heading">
        <div><p class="instrument-label">02 · Complete curriculum</p><h2 id="route-title">Nine connected parts, not forty-six isolated topics</h2></div>
        <p>Each part closes one unanswered question before opening the next. The route covers the major problem settings, method families, training signals, evaluation tools, system concerns, and language-model post-training boundaries.</p>
      </div>
      <div class="lesson-roadmap">
        {partRows.map((part, partIndex) => (
          <section class="route-stage" aria-labelledby={`part-${part.id}`}>
            <header>
              <div><span>{String(partIndex + 1).padStart(2, "0")}</span><h3 id={`part-${part.id}`}>{part.title}</h3></div>
              <p>{part.purpose}</p>
              <small>{part.chapters.length} chapters</small>
            </header>
            {part.chapters.map((chapter) => (
              <article class="roadmap-card">
                <a class="roadmap-link" href={`${base}/en/learn/${chapter.slug}/`} aria-label={`Chapter ${chapter.order}: ${chapter.title}`}>
                  <div class="roadmap-index"><span>{String(chapter.order).padStart(2, "0")}</span><small>Part {partIndex + 1}</small></div>
                  <div class="roadmap-copy"><h4>{chapter.title}</h4><p>{chapter.purpose}</p><div><span>Core diagram</span><span>Worked example</span><span>Formula + boundary</span></div></div>
                  <span class="roadmap-open" aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </section>
        ))}
      </div>
    </section>
  </main>
</GuideLayout>
