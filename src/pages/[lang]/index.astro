---
import GuideHeader from "@/components/GuideHeader.astro";
import LearningLoopVisual from "@/components/LearningLoopVisual.astro";
import MethodMap from "@/components/MethodMap.astro";
import type { Language } from "@/content/bilingual-course";
import { getLocalizedCurriculum, getLocalizedParts } from "@/content/localized-curriculum";
import { READING_MODES, languageDestinations, type ReadingMode } from "@/content/reading-mode";
import GuideLayout from "@/layouts/GuideLayout.astro";

export function getStaticPaths() {
  return READING_MODES.map((mode) => ({ params: { lang: mode }, props: { mode } }));
}

const { mode } = Astro.props as { mode: ReadingMode };
const language: Language = mode === "zh" ? "zh" : "en";
const CURRICULUM = getLocalizedCurriculum(language);
const PARTS = getLocalizedParts(language);
const ZH_CURRICULUM = getLocalizedCurriculum("zh");
const zh = mode === "zh";
const bilingual = mode === "bilingual";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeHref = `${base}/${mode}/`;
const startHref = `${base}/${mode}/learn/rl-panorama/`;
const languageLinks = languageDestinations().map((item) => ({
  mode: item.mode,
  href: `${base}${item.path}`,
  label: item.mode === "en" ? "EN" : item.mode === "zh" ? "中" : "中/EN",
  accessibleLabel: item.mode === "en" ? "Read in English" : item.mode === "zh" ? "阅读中文版" : "Read alternating English and Chinese",
}));
const alternatePaths = [
  { hreflang: "en", path: `${base}/en/` },
  { hreflang: "zh-CN", path: `${base}/zh/` },
  { hreflang: "x-default", path: `${base}/bilingual/` },
];
const partRows = PARTS.map((part) => ({ ...part, chapters: CURRICULUM.filter((chapter) => chapter.part === part.id) }));
const t = zh ? {
  title: "强化学习指南 · 完整阅读课程", description: "第 00 章全景文章，加上 46 章深入讲解的中英双语强化学习课程。", brand: "RL 学习指南", theme: "切换颜色主题", alternate: "English",
  eyebrow: "第 00 章全景导读 · 46 章深入讲解 · 9 部分", hero: "一套沿着决策与证据链展开的强化学习指南", strapline: "先用一篇文章看见整片森林，再逐章走进每一种机制。",
  intro: "第 00 章用一台送货机器人串起强化学习的主要问题与方法。后面的章节放慢速度，从情境、算例和公式中追踪证据，也会明确每种结论的适用边界。",
  start: "先读全景文章", map: "查看完整路线", contract: "阅读约定", promises: ["先理解问题，再记算法名称", "每章一张语义图和一个完整算例", "公式必须回到可见的量", "包含反例、边界与原始资料"],
  how: "01 · 怎么读", methodTitle: "每章都使用同一条证据循环", methods: [["预测", "在解释让答案显得显然之前，先写下自己的判断。"], ["追踪", "沿一个具体案例追踪状态、动作、反馈与下一后果。"], ["计算", "复算数值目标或程序判断，不跳过中间步骤。"], ["命名", "机制已有意义后，再附上术语和符号。"], ["拆解", "用反例、缺失假设或未覆盖状态检验边界。"]],
  curriculum: "02 · 完整课程", routeTitle: "九个相连部分，而不是四十六个孤立主题", routeIntro: "每部分先关闭一个未回答的问题，再打开下一个。路线覆盖主要问题设定、方法家族、训练信号、评估工具、系统问题和语言模型后训练边界。", chapters: "章", part: "部分", diagram: "核心图解", example: "完整算例", formula: "公式与边界",
} : bilingual ? {
  title: "RL Field Guide · 中英逐段阅读", description: "An alternating English and Chinese route through the complete reinforcement-learning field guide.", brand: "RL 学习指南", theme: "Theme / 主题",
  eyebrow: "CHAPTER 00 / 第 00 章 · 46 CHAPTERS / 46 章 · 9 PARTS / 9 部分", hero: "One field guide, read in two languages", strapline: "Each English passage is followed by its Chinese counterpart. / 每段英文之后紧接对应中文。",
  intro: "Begin with the panorama, then open any chapter without losing the bilingual rhythm. Technical names are introduced only after the problem has become visible. / 先读全景导读，再进入任意章节；问题先被看见，术语随后才出现。",
  start: "Read Chapter 00 / 阅读第 00 章", map: "See the complete route / 查看完整路线", contract: "READING CONTRACT / 阅读约定", promises: ["Problem before terminology / 先讲问题，再给术语", "English then Chinese / 英文在前，中文紧随", "One shared equation, two explanations / 公式只出现一次，解释双语对应", "Boundaries and sources remain visible / 边界与资料不省略"],
  how: "01 · HOW TO READ / 怎么读", methodTitle: "One evidence loop, repeated in two languages", methods: [["Predict / 预测", "Commit to an answer before reading the explanation. / 在解释出现以前，先写下自己的判断。"], ["Trace / 追踪", "Follow one concrete chain of action and consequence. / 沿着一条具体的行动与后果链往下走。"], ["Calculate / 计算", "Keep every intermediate quantity visible. / 不省略中间量。"], ["Name / 命名", "Attach the formal name only after the mechanism is clear. / 机制清楚以后再贴上正式名称。"], ["Break / 拆解", "Ask where the claim stops being supported. / 追问结论的证据边界。"]],
  curriculum: "02 · COMPLETE CURRICULUM / 完整课程", routeTitle: "Nine connected parts, not forty-six isolated labels", routeIntro: "Every chapter closes one question and opens the next. / 每一章先收住一个问题，再自然地打开下一个。", chapters: "chapters / 章", part: "Part / 部分", diagram: "Diagram / 图解", example: "Example / 算例", formula: "Formula + boundary / 公式与边界",
} : {
  title: "RL Field Guide · A complete reading course", description: "A read-first panorama plus 46 deep chapters covering reinforcement learning from sequential decisions through language-model post-training.", brand: "RL FIELD GUIDE", theme: "Switch color theme", alternate: "中文",
  eyebrow: "Chapter 00 panorama · 46 deep chapters · 9 parts", hero: "A field guide to reinforcement learning", strapline: "See the whole landscape in one essay, then walk into each mechanism.",
  intro: "Chapter 00 follows one delivery robot through the problems that created the major families of RL methods. The chapters that follow slow the journey down, trace evidence through examples and equations, and mark the boundary of every claim.",
  start: "Read the panorama first", map: "See the complete field map", contract: "Reading contract", promises: ["Understand the problem before naming the algorithm", "One semantic diagram and one worked example per chapter", "Equations tied back to visible quantities", "Counterexamples, boundaries, and original sources"],
  how: "01 · How to read", methodTitle: "Use the same evidence loop in every chapter", methods: [["Predict", "Commit to what you expect before the explanation makes the answer feel obvious."], ["Trace", "Follow the state, action, feedback, and next consequence through one concrete case."], ["Calculate", "Reproduce the numeric target or procedural decision with every intermediate step visible."], ["Name", "Attach terminology and notation only after the mechanism already has meaning."], ["Break", "Test the boundary with a counterexample, missing assumption, or unsupported state."]],
  curriculum: "02 · Complete curriculum", routeTitle: "Nine connected parts, not forty-six isolated topics", routeIntro: "Each part closes one unanswered question before opening the next. The route covers the major problem settings, method families, training signals, evaluation tools, system concerns, and language-model post-training boundaries.", chapters: "chapters", part: "Part", diagram: "Core diagram", example: "Worked example", formula: "Formula + boundary",
};
---

<GuideLayout title={t.title} description={t.description} mode={mode} canonicalPath={homeHref} alternatePaths={alternatePaths}>
  <GuideHeader mode={mode} brand={t.brand} homeHref={homeHref} themeLabel={t.theme} languageLinks={languageLinks} />

  <main id="main-content" class="course-home" tabindex="-1">
    <section class="course-hero">
      <div class="course-hero-copy">
        <p class="instrument-label">{t.eyebrow}</p>
        <h1>{t.hero}</h1>
        <p class="course-strapline">{t.strapline}</p>
        <p class="course-intro">{t.intro}</p>
        <div class="hero-actions">
          <a class="primary-link" href={startHref}>{t.start}<span>→</span></a>
          <a class="text-link" href="#course-route">{t.map}<span>↓</span></a>
        </div>
        <div class="course-promises" aria-label="Reading contract">
          <strong>{t.contract}</strong>
          <ul>{t.promises.map((promise) => <li>{promise}</li>)}</ul>
        </div>
      </div>
      <LearningLoopVisual language={language} />
    </section>

    <section class="method-section" aria-labelledby="method-title">
      <div class="section-heading">
        <p class="instrument-label">{t.how}</p>
        <h2 id="method-title">{t.methodTitle}</h2>
      </div>
      <div class="method-layout">
        <ol class="method-steps">{t.methods.map((method, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{method[0]}</h3><p>{method[1]}</p></div></li>)}</ol>
        <MethodMap language={language} />
      </div>
    </section>

    <section id="course-route" class="route-section" aria-labelledby="route-title">
      <div class="section-heading route-heading">
        <div><p class="instrument-label">{t.curriculum}</p><h2 id="route-title">{t.routeTitle}</h2></div>
        <p>{t.routeIntro}</p>
      </div>
      <div class="lesson-roadmap">
        {partRows.map((part, partIndex) => (
          <section class="route-stage" aria-labelledby={`part-${part.id}`}>
            <header>
              <div><span>{String(partIndex + 1).padStart(2, "0")}</span><h3 id={`part-${part.id}`}>{part.title}</h3></div>
              <p>{part.purpose}</p>
              <small>{part.chapters.length} {t.chapters}</small>
            </header>
            {part.chapters.map((chapter) => (
              <article class="roadmap-card">
                <a class="roadmap-link" href={`${base}/${mode}/learn/${chapter.slug}/`} aria-label={`${zh ? "第" : "Chapter"} ${chapter.order}: ${chapter.title}`}>
                  <div class="roadmap-index"><span>{String(chapter.order).padStart(2, "0")}</span><small>{t.part} {partIndex + 1}</small></div>
                  <div class="roadmap-copy"><h4>{chapter.title}</h4>{bilingual ? <h5 lang="zh-CN">{ZH_CURRICULUM.find((item) => item.slug === chapter.slug)?.title}</h5> : null}<p>{chapter.purpose}</p>{bilingual ? <p lang="zh-CN">{ZH_CURRICULUM.find((item) => item.slug === chapter.slug)?.purpose}</p> : null}<div><span>{t.diagram}</span><span>{t.example}</span><span>{t.formula}</span></div></div>
                  <span class="roadmap-open" aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </section>
        ))}
      </div>
    </section>
  </main>
</GuideLayout>
