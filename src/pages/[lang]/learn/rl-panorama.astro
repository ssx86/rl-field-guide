---
import GuideHeader from "@/components/GuideHeader.astro";
import KnowledgeText from "@/components/KnowledgeText.astro";
import LinkedHeading from "@/components/LinkedHeading.astro";
import PanoramaParagraph from "@/components/PanoramaParagraph.astro";
import PanoramaRoute from "@/components/PanoramaRoute.astro";
import type { Language } from "@/content/bilingual-course";
import { getPanoramaArticle } from "@/content/panorama-article";
import { getLocalizedCurriculum } from "@/content/localized-curriculum";
import { createKnowledgeAnnotator } from "@/content/knowledge-text";
import { READING_MODES, languageDestinations, type ReadingMode } from "@/content/reading-mode";
import GuideLayout from "@/layouts/GuideLayout.astro";

export function getStaticPaths() {
  return READING_MODES.map((mode) => ({ params: { lang: mode }, props: { mode } }));
}

const { mode } = Astro.props as { mode: ReadingMode };
const language: Language = mode === "zh" ? "zh" : "en";
const article = getPanoramaArticle(language);
const englishArticle = getPanoramaArticle("en");
const chineseArticle = getPanoramaArticle("zh");
const zh = mode === "zh";
const bilingual = mode === "bilingual";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeHref = `${base}/${mode}/`;
const canonicalPath = `${base}/${mode}/learn/rl-panorama/`;
const languageLinks = languageDestinations("rl-panorama").map((item) => ({ mode: item.mode, href: `${base}${item.path}`, label: item.mode === "en" ? "EN" : item.mode === "zh" ? "中" : "中/EN", accessibleLabel: item.mode === "en" ? "Read the guide in English" : item.mode === "zh" ? "阅读中文导读" : "Read alternating English and Chinese" }));
const alternatePaths = [{ hreflang: "en", path: `${base}/en/learn/rl-panorama/` }, { hreflang: "zh-CN", path: `${base}/zh/learn/rl-panorama/` }, { hreflang: "x-default", path: `${base}/bilingual/learn/rl-panorama/` }];
const firstChapter = getLocalizedCurriculum(language)[0];
const t = zh ? {
  brand: "RL 学习指南",
  theme: "切换颜色主题",
  alternate: "English",
  route: "同一个机器人，九次问题升级",
  contents: "本文的九次转折",
  diagnosis: "读完后的定位工具",
  continue: "继续深入",
  continueTitle: "现在开始逐章拆解",
  continueCopy: "全景文章负责把问题连成一条线。后面的章节会把每一种机制放回算例、公式、失败边界与原始资料中。",
  start: "进入第 01 章",
  map: "返回课程地图",
} : {
  brand: "RL FIELD GUIDE",
  theme: "Switch color theme",
  alternate: "中文",
  route: "One robot, nine changes of the problem",
  contents: "The nine turns in this essay",
  diagnosis: "A diagnostic tool to keep",
  continue: "Continue the course",
  continueTitle: "Now slow the journey down",
  continueCopy: "This essay connects the questions. The deep chapters put each mechanism back into worked evidence, equations, failure boundaries, and original sources.",
  start: "Open Chapter 01",
  map: "Return to the field map",
};
const pair = <T, U>(left: readonly T[], right: readonly U[]) => Array.from({ length: Math.max(left.length, right.length) }, (_, index) => ({ left: left[index], right: right[index] }));
const annotateEn = createKnowledgeAnnotator("en");
const annotateZh = createKnowledgeAnnotator("zh");
const annotate = language === "zh" ? annotateZh : annotateEn;
---

<GuideLayout title={`${article.title} · ${t.brand}`} description={article.deck} mode={mode} canonicalPath={canonicalPath} alternatePaths={alternatePaths} languageHashMode="all" knowledgeSlug="rl-panorama">
  <GuideHeader mode={mode} brand={bilingual ? "RL 学习指南" : t.brand} homeHref={homeHref} themeLabel={bilingual ? "Theme / 主题" : t.theme} languageLinks={languageLinks} />

  <main id="main-content" class="panorama-shell" tabindex="-1">
    <aside class="panorama-rail" aria-label={t.contents}>
      <a class="rail-home" href={homeHref}>← {t.map}</a>
      <p class="instrument-label">{t.contents}</p>
      <nav>
        {article.movements.map((movement, index) => (
          <a href={`#${movement.id}`}><span>{movement.number}</span><em>{movement.title}{bilingual ? <small lang="zh-CN">{chineseArticle.movements[index].title}</small> : null}</em></a>
        ))}
      </nav>
    </aside>

    <article class="panorama-article">
      <header class="panorama-intro">
        <p class="instrument-label">{article.eyebrow}</p>
        <h1>{article.title}</h1>
        {bilingual ? <h2 class="panorama-title-translation" lang="zh-CN">{chineseArticle.title}</h2> : null}
        <p class="panorama-deck">{article.deck}</p>
        {bilingual ? <p class="panorama-deck" lang="zh-CN"><span class="language-marker" aria-hidden="true">中</span>{chineseArticle.deck}</p> : null}
        <div class={`panorama-opening ${bilingual ? "bilingual-prose" : ""}`}>
          {bilingual ? pair(englishArticle.opening, chineseArticle.opening).map(({ left, right }) => <div class="language-pair">{left ? <><span class="language-marker" aria-hidden="true">EN</span><p lang="en"><KnowledgeText segments={annotateEn(left, "opening")} language="en" mode={mode} base={base} /></p></> : null}{right ? <><span class="language-marker" aria-hidden="true">中</span><p lang="zh-CN"><KnowledgeText segments={annotateZh(right, "opening")} language="zh" mode={mode} base={base} /></p></> : null}</div>) : article.opening.map((paragraph) => <p><KnowledgeText segments={annotate(paragraph, "opening")} language={language} mode={mode} base={base} /></p>)}
        </div>
        <PanoramaRoute movements={article.movements} label={t.route} />
      </header>

      <details class="panorama-mobile-nav">
        <summary>{t.contents}</summary>
        <nav>{article.movements.map((movement) => <a href={`#${movement.id}`}>{movement.number} · {movement.title}</a>)}</nav>
      </details>

      {article.movements.map((movement, movementIndex) => (
        <section id={movement.id} class="panorama-movement" aria-labelledby={`${movement.id}-title`}>
          <header>
            <span>{movement.number}</span>
            <div>
              <LinkedHeading id={`${movement.id}-title`} hash={movement.id} label={movement.title} copyLabel={zh ? "复制本节链接" : "Copy link to this section"}>{movement.title}</LinkedHeading>
              {bilingual ? <h3 lang="zh-CN">{chineseArticle.movements[movementIndex].title}</h3> : null}
            </div>
          </header>
          <div class="panorama-prose">
            {bilingual ? <><div class="language-pair compact"><span class="language-marker" aria-hidden="true">EN</span><p class="panorama-turn" lang="en"><KnowledgeText segments={annotateEn(movement.turn, movement.id)} language="en" mode={mode} base={base} /></p><span class="language-marker" aria-hidden="true">中</span><p class="panorama-turn" lang="zh-CN"><KnowledgeText segments={annotateZh(chineseArticle.movements[movementIndex].turn, movement.id)} language="zh" mode={mode} base={base} /></p></div>{pair(movement.paragraphs, chineseArticle.movements[movementIndex].paragraphs).map(({ left, right }) => <div class="language-pair">{left ? <><span class="language-marker" aria-hidden="true">EN</span><div lang="en"><PanoramaParagraph segments={annotateEn(left, movement.id)} base={base} mode={mode} language="en" /></div></> : null}{right ? <><span class="language-marker" aria-hidden="true">中</span><div lang="zh-CN"><PanoramaParagraph segments={annotateZh(right, movement.id)} base={base} mode={mode} language="zh" /></div></> : null}</div>)}<div class="language-pair compact"><span class="language-marker" aria-hidden="true">EN</span><p class="panorama-coda" lang="en"><KnowledgeText segments={annotateEn(movement.coda, movement.id)} language="en" mode={mode} base={base} /></p><span class="language-marker" aria-hidden="true">中</span><p class="panorama-coda" lang="zh-CN"><KnowledgeText segments={annotateZh(chineseArticle.movements[movementIndex].coda, movement.id)} language="zh" mode={mode} base={base} /></p></div></> : <><p class="panorama-turn"><KnowledgeText segments={annotate(movement.turn, movement.id)} language={language} mode={mode} base={base} /></p>{movement.paragraphs.map((paragraph) => <PanoramaParagraph segments={annotate(paragraph, movement.id)} base={base} mode={mode} language={language} />)}<p class="panorama-coda"><KnowledgeText segments={annotate(movement.coda, movement.id)} language={language} mode={mode} base={base} /></p></>}
          </div>
        </section>
      ))}

      <section id="diagnostic" class="panorama-diagnostic" aria-labelledby="diagnostic-title">
        <p class="instrument-label">{t.diagnosis}</p>
        <LinkedHeading id="diagnostic-title" hash="diagnostic" label={article.diagnosticTitle} copyLabel={zh ? "复制本节链接" : "Copy link to this section"}>{article.diagnosticTitle}</LinkedHeading>
        {bilingual ? <h3 lang="zh-CN">{chineseArticle.diagnosticTitle}</h3> : null}
        <p><KnowledgeText segments={(bilingual ? annotateEn : annotate)(article.diagnosticIntro, "diagnostic")} language={bilingual ? "en" : language} mode={mode} base={base} /></p>{bilingual ? <p lang="zh-CN"><KnowledgeText segments={annotateZh(chineseArticle.diagnosticIntro, "diagnostic")} language="zh" mode={mode} base={base} /></p> : null}
        <ol>{article.diagnosticQuestions.map((question, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><p><KnowledgeText segments={(bilingual ? annotateEn : annotate)(question, "diagnostic")} language={bilingual ? "en" : language} mode={mode} base={base} /></p>{bilingual ? <p lang="zh-CN"><KnowledgeText segments={annotateZh(chineseArticle.diagnosticQuestions[index], "diagnostic")} language="zh" mode={mode} base={base} /></p> : null}</div></li>)}</ol>
      </section>

      <footer class="panorama-closing">
        {bilingual ? pair(englishArticle.closing, chineseArticle.closing).map(({ left, right }) => <div class="language-pair">{left ? <><span class="language-marker" aria-hidden="true">EN</span><p lang="en"><KnowledgeText segments={annotateEn(left, "closing")} language="en" mode={mode} base={base} /></p></> : null}{right ? <><span class="language-marker" aria-hidden="true">中</span><p lang="zh-CN"><KnowledgeText segments={annotateZh(right, "closing")} language="zh" mode={mode} base={base} /></p></> : null}</div>) : article.closing.map((paragraph) => <p><KnowledgeText segments={annotate(paragraph, "closing")} language={language} mode={mode} base={base} /></p>)}
        <div class="panorama-next-actions">
          <div><p class="instrument-label">{t.continue}</p><h2>{t.continueTitle}</h2><p>{t.continueCopy}</p></div>
          <div><a class="primary-link" href={`${base}/${mode}/learn/${firstChapter.slug}/`}>{bilingual ? "Open Chapter 01 / 进入第 01 章" : t.start}<span>→</span></a><a class="text-link" href={homeHref}>{t.map}<span>↑</span></a></div>
        </div>
      </footer>
    </article>
  </main>
</GuideLayout>
