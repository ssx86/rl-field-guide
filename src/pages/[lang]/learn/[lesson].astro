---
import katex from "katex";
import ArticleDiagram from "@/components/ArticleDiagram.astro";
import GuideHeader from "@/components/GuideHeader.astro";
import type { Language } from "@/content/bilingual-course";
import { getLocalizedChapterArticle } from "@/content/chapter-localization";
import { getLocalizedCurriculum, getLocalizedParts } from "@/content/localized-curriculum";
import GuideLayout from "@/layouts/GuideLayout.astro";

export function getStaticPaths() {
  return (["en", "zh"] as const).flatMap((language) => getLocalizedCurriculum(language).map((chapter) => ({
    params: { lang: language, lesson: chapter.slug },
    props: { slug: chapter.slug, language },
  })));
}

const { slug, language } = Astro.props as { slug: string; language: Language };
const zh = language === "zh";
const CURRICULUM = getLocalizedCurriculum(language);
const PARTS = getLocalizedParts(language);
const chapter = getLocalizedChapterArticle(language, slug);
const route = CURRICULUM.find((item) => item.slug === slug)!;
const chapterIndex = CURRICULUM.findIndex((item) => item.slug === slug);
const previous = CURRICULUM[chapterIndex - 1];
const next = CURRICULUM[chapterIndex + 1];
const partIndex = PARTS.findIndex((part) => part.id === route.part);
const part = PARTS[partIndex];
const partChapters = CURRICULUM.filter((item) => item.part === route.part);
const prerequisites = route.prerequisites.map((item) => CURRICULUM.find((candidate) => candidate.slug === item)).filter(Boolean);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeHref = `${base}/${language}/`;
const lessonHref = `${base}/${language}/learn/${slug}/`;
const alternateHref = `${base}/${zh ? "en" : "zh"}/learn/${slug}/`;
const t = zh ? {
  brand: "RL 学习指南", theme: "切换颜色主题", alternate: "English", map: "完整课程地图", part: "部分", chapter: "第", openPart: "打开本部分", noPrior: "无需任何 RL 前置术语", builds: "前置基础", why: "为什么此处学习", sections: "章节目录",
  nav: ["情境", "图解", "算例", "机制", "公式", "边界"], situation: "问题从这里生长", diagram: "把关系摊开", example: "跟着数字走一遍", pause: "先别往下看：你会怎样算？", result: "算完以后", mechanism: "现在给它一个名字", mechanismTitle: "这个例子真正说明了什么", equations: "符号，是对关系的压缩", equationsTitle: "等每个量都有工作，再读公式", equationLead: "这些符号不是另一套故事。它们只是把刚才已经看见的关系压缩到一行里。", boundary: "别把结论说过头", sources: "原始与官方资料", sourcesTitle: "沿着原始资料继续追", previous: "上一章", next: "下一章", returnMap: "返回课程地图", revisit: "选择一条路线重新学习",
} : {
  brand: "RL FIELD GUIDE", theme: "Switch color theme", alternate: "中文", map: "Complete field map", part: "Part", chapter: "Chapter", openPart: "Open this part", noPrior: "No prior RL vocabulary required", builds: "Builds on", why: "Why it is here", sections: "Chapter sections",
  nav: ["Situation", "Diagram", "Example", "Mechanism", "Equations", "Boundary"], situation: "Where the question begins", diagram: "Lay the relationship out", example: "Follow the numbers", pause: "Stop here: what would you calculate?", result: "After the calculation", mechanism: "Now give it a name", mechanismTitle: "What the example was really showing", equations: "Notation as compression", equationsTitle: "Read the equation after every quantity has a job", equationLead: "The notation below is not a second story. It compresses the relationships you have already seen into one line.", boundary: "Do not carry the claim past this point", sources: "Original and official sources", sourcesTitle: "Follow the argument into the primary sources", previous: "Previous", next: "Next", returnMap: "Return to field map", revisit: "Choose a route to revisit",
};
---

<GuideLayout title={`${chapter.title} · ${t.brand}`} description={chapter.deck} language={language} canonicalPath={lessonHref} alternatePath={alternateHref}>
  <GuideHeader language={language} brand={t.brand} homeHref={homeHref} themeLabel={t.theme} alternateHref={alternateHref} alternateLabel={t.alternate} />

  <main id="main-content" class="lesson-shell" tabindex="-1">
    <aside class="lesson-rail" aria-label={`${part.title} chapters`}>
      <a class="rail-home" href={homeHref}>← {t.map}</a>
      <p class="instrument-label">{t.part} {partIndex + 1} · {part.title}</p>
      <nav class="lesson-rail-links">
        {partChapters.map((item) => (
          <a data-lesson-id={item.slug} href={`${base}/${language}/learn/${item.slug}/`} aria-current={item.slug === slug ? "page" : undefined}>
            <span>{String(item.order).padStart(2, "0")}</span><em>{item.title}</em>
          </a>
        ))}
      </nav>
      <div class="lesson-mobile-current">
        {previous ? <a href={`${base}/${language}/learn/${previous.slug}/`} aria-label={`${t.previous}: ${previous.title}`}>←</a> : <span aria-hidden="true">·</span>}
        <strong>{String(route.order).padStart(2, "0")} / {CURRICULUM.length}<small>{chapter.title}</small></strong>
        {next ? <a href={`${base}/${language}/learn/${next.slug}/`} aria-label={`${t.next}: ${next.title}`}>→</a> : <span aria-hidden="true">·</span>}
      </div>
      <details class="lesson-mobile-menu">
        <summary>{t.openPart}</summary>
        <nav>{partChapters.map((item) => <a href={`${base}/${language}/learn/${item.slug}/`} aria-current={item.slug === slug ? "page" : undefined}><span>{String(item.order).padStart(2, "0")}</span>{item.title}</a>)}</nav>
      </details>
    </aside>

    <article class="lesson-article">
      <header class="lesson-intro">
        <div class="lesson-meta"><span>{t.part} {partIndex + 1} · {part.title}</span><span>{t.chapter} {String(route.order).padStart(2, "0")} / {CURRICULUM.length}</span></div>
        <h1>{chapter.title}</h1>
        <p class="lesson-subtitle">{chapter.deck}</p>
        <blockquote>{chapter.openingQuestion}</blockquote>
        <dl class="lesson-contract">
          <div><dt>{t.builds}</dt><dd>{prerequisites.length ? prerequisites.map((item, index) => <><a href={`${base}/${language}/learn/${item!.slug}/`}>{item!.title}</a>{index < prerequisites.length - 1 ? " · " : ""}</>) : t.noPrior}</dd></div>
          <div><dt>{t.why}</dt><dd>{route.purpose}</dd></div>
        </dl>
      </header>

      <nav class="lesson-sections" aria-label={t.sections}>
        <a href="#situation">{t.nav[0]}</a><a href="#diagram">{t.nav[1]}</a><a href="#example">{t.nav[2]}</a><a href="#mechanism">{t.nav[3]}</a>{chapter.equations.length ? <a href="#equations">{t.nav[4]}</a> : null}<a href="#boundary">{t.nav[5]}</a>
      </nav>

      <section id="situation" class="lesson-section" aria-labelledby="situation-title">
        <p class="instrument-label">{t.situation}</p>
        <h2 id="situation-title">{chapter.situation.title}</h2>
        <div class="longform-prose">
          <p class="chapter-bridge">{chapter.bridge}</p>
          {chapter.situation.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section id="diagram" class="lesson-section diagram-section">
        <ArticleDiagram diagram={chapter.diagram} slug={slug} label={t.diagram} />
      </section>

      <section id="example" class="lesson-section" aria-labelledby="example-title">
        <p class="instrument-label">{t.example}</p>
        <h2 id="example-title">{chapter.workedExample.title}</h2>
        <div class="longform-prose section-lead"><p>{chapter.workedExample.setup}</p></div>
        <article class="static-evidence">
          <header>
            <p class="instrument-label">{t.pause}</p>
            <h3>{chapter.workedExample.prediction}</h3>
          </header>
          <ol class="static-evidence-steps">
            {chapter.workedExample.steps.map((step, index) => (
              <li><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{step.label}</strong><code>{step.calculation}</code><p>{step.explanation}</p></div></li>
            ))}
          </ol>
          <p class="worked-result"><strong>{t.result}</strong>{chapter.workedExample.result}</p>
        </article>
      </section>

      <section id="mechanism" class="lesson-section" aria-labelledby="mechanism-title">
        <p class="instrument-label">{t.mechanism}</p>
        <h2 id="mechanism-title">{t.mechanismTitle}</h2>
        <div class="longform-prose">
          <p>{chapter.mechanism.introduction}</p>
          {chapter.mechanism.sections.map((section) => (
            <section class="prose-subsection">
              <span class="prose-marker" aria-hidden="true"></span>
              <h3>{section.title}</h3>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </section>
          ))}
        </div>
      </section>

      {chapter.equations.length ? (
        <section id="equations" class="lesson-section" aria-labelledby="equations-title">
          <p class="instrument-label">{t.equations}</p>
          <h2 id="equations-title">{t.equationsTitle}</h2>
          <div class="longform-prose section-lead"><p>{t.equationLead}</p></div>
          <div class="formula-list">
            {chapter.equations.map((equation) => (
              <article>
                <div class="formula-render" set:html={katex.renderToString(equation.latex, { displayMode: true, throwOnError: true })} />
                <p><strong>{equation.read}</strong></p>
                <p>{equation.meaning}</p>
              </article>
            ))}
          </div>
        </section>
      ) : null}

      <section id="boundary" class="lesson-section boundary-section" aria-labelledby="boundary-title">
        <p class="instrument-label">{t.boundary}</p>
        <h2 id="boundary-title">{chapter.boundary.title}</h2>
        <div class="longform-prose">{chapter.boundary.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
      </section>

      <section class="lesson-references" aria-labelledby="sources-title">
        <p class="instrument-label">{t.sources}</p>
        <h2 id="sources-title">{t.sourcesTitle}</h2>
        <ul>{chapter.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer"><span>{source.label}<small>{source.kind}</small></span><span aria-hidden="true">↗</span></a></li>)}</ul>
      </section>

      <nav class="lesson-next" aria-label="Chapter pagination">
        {previous ? <a href={`${base}/${language}/learn/${previous.slug}/`}><small>← {t.previous}</small><strong>{previous.title}</strong></a> : <a href={homeHref}><small>← {t.map}</small><strong>{t.brand}</strong></a>}
        {next ? <a class="next-link" href={`${base}/${language}/learn/${next.slug}/`}><small>{t.next} →</small><strong>{next.title}</strong><span>{chapter.nextBridge}</span></a> : <a class="next-link" href={homeHref}><small>{t.returnMap} →</small><strong>{t.revisit}</strong><span>{chapter.nextBridge}</span></a>}
      </nav>
    </article>
  </main>
  <script is:inline>document.querySelector('.lesson-rail-links [aria-current="page"]')?.scrollIntoView({ block: "center", inline: "nearest" });</script>
</GuideLayout>
