---
import katex from "katex";
import ArticleDiagram from "@/components/ArticleDiagram.astro";
import GuideHeader from "@/components/GuideHeader.astro";
import { getChapterArticle } from "@/content/chapter-articles";
import { CURRICULUM, PARTS } from "@/content/curriculum";
import GuideLayout from "@/layouts/GuideLayout.astro";

export function getStaticPaths() {
  return CURRICULUM.map((chapter) => ({
    params: { lang: "en", lesson: chapter.slug },
    props: { slug: chapter.slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const chapter = getChapterArticle(slug);
const route = CURRICULUM.find((item) => item.slug === slug)!;
const chapterIndex = CURRICULUM.findIndex((item) => item.slug === slug);
const previous = CURRICULUM[chapterIndex - 1];
const next = CURRICULUM[chapterIndex + 1];
const partIndex = PARTS.findIndex((part) => part.id === route.part);
const part = PARTS[partIndex];
const partChapters = CURRICULUM.filter((item) => item.part === route.part);
const prerequisites = route.prerequisites.map((item) => CURRICULUM.find((candidate) => candidate.slug === item)).filter(Boolean);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeHref = `${base}/en/`;
const lessonHref = `${base}/en/learn/${slug}/`;
---

<GuideLayout title={`${chapter.title} · RL Field Guide`} description={chapter.deck} language="en" canonicalPath={lessonHref}>
  <GuideHeader language="en" brand="RL FIELD GUIDE" homeHref={homeHref} themeLabel="Switch color theme" />

  <main id="main-content" class="lesson-shell" tabindex="-1">
    <aside class="lesson-rail" aria-label={`${part.title} chapters`}>
      <a class="rail-home" href={homeHref}>← Complete field map</a>
      <p class="instrument-label">Part {partIndex + 1} · {part.title}</p>
      <nav class="lesson-rail-links">
        {partChapters.map((item) => (
          <a data-lesson-id={item.slug} href={`${base}/en/learn/${item.slug}/`} aria-current={item.slug === slug ? "page" : undefined}>
            <span>{String(item.order).padStart(2, "0")}</span><em>{item.title}</em>
          </a>
        ))}
      </nav>
      <div class="lesson-mobile-current">
        {previous ? <a href={`${base}/en/learn/${previous.slug}/`} aria-label={`Previous: ${previous.title}`}>←</a> : <span aria-hidden="true">·</span>}
        <strong>{String(route.order).padStart(2, "0")} / {CURRICULUM.length}<small>{chapter.title}</small></strong>
        {next ? <a href={`${base}/en/learn/${next.slug}/`} aria-label={`Next: ${next.title}`}>→</a> : <span aria-hidden="true">·</span>}
      </div>
      <details class="lesson-mobile-menu">
        <summary>Open this part</summary>
        <nav>{partChapters.map((item) => <a href={`${base}/en/learn/${item.slug}/`} aria-current={item.slug === slug ? "page" : undefined}><span>{String(item.order).padStart(2, "0")}</span>{item.title}</a>)}</nav>
      </details>
    </aside>

    <article class="lesson-article">
      <header class="lesson-intro">
        <div class="lesson-meta"><span>Part {partIndex + 1} · {part.title}</span><span>Chapter {String(route.order).padStart(2, "0")} / {CURRICULUM.length}</span></div>
        <h1>{chapter.title}</h1>
        <p class="lesson-subtitle">{chapter.deck}</p>
        <blockquote>{chapter.openingQuestion}</blockquote>
        <dl class="lesson-contract">
          <div><dt>Builds on</dt><dd>{prerequisites.length ? prerequisites.map((item, index) => <><a href={`${base}/en/learn/${item!.slug}/`}>{item!.title}</a>{index < prerequisites.length - 1 ? " · " : ""}</>) : "No prior RL vocabulary required"}</dd></div>
          <div><dt>Why it is here</dt><dd>{route.purpose}</dd></div>
        </dl>
      </header>

      <nav class="lesson-sections" aria-label="Chapter sections">
        <a href="#situation">Situation</a><a href="#diagram">Diagram</a><a href="#example">Example</a><a href="#mechanism">Mechanism</a>{chapter.equations.length ? <a href="#equations">Equations</a> : null}<a href="#boundary">Boundary</a>
      </nav>

      <section id="situation" class="lesson-section" aria-labelledby="situation-title">
        <p class="instrument-label">01 · Why this question comes next</p>
        <h2 id="situation-title">{chapter.situation.title}</h2>
        <div class="longform-prose">
          <p class="chapter-bridge">{chapter.bridge}</p>
          {chapter.situation.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section id="diagram" class="lesson-section diagram-section">
        <ArticleDiagram diagram={chapter.diagram} slug={slug} />
      </section>

      <section id="example" class="lesson-section" aria-labelledby="example-title">
        <p class="instrument-label">03 · Work the evidence</p>
        <h2 id="example-title">{chapter.workedExample.title}</h2>
        <div class="longform-prose section-lead"><p>{chapter.workedExample.setup}</p></div>
        <article class="static-evidence">
          <header>
            <p class="instrument-label">Pause before calculating</p>
            <h3>{chapter.workedExample.prediction}</h3>
          </header>
          <ol class="static-evidence-steps">
            {chapter.workedExample.steps.map((step, index) => (
              <li><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{step.label}</strong><code>{step.calculation}</code><p>{step.explanation}</p></div></li>
            ))}
          </ol>
          <p class="worked-result"><strong>Result</strong>{chapter.workedExample.result}</p>
        </article>
      </section>

      <section id="mechanism" class="lesson-section" aria-labelledby="mechanism-title">
        <p class="instrument-label">04 · Name the mechanism</p>
        <h2 id="mechanism-title">The relationships behind the example</h2>
        <div class="longform-prose">
          <p>{chapter.mechanism.introduction}</p>
          {chapter.mechanism.sections.map((section, index) => (
            <section class="prose-subsection">
              <p class="prose-kicker">{String(index + 1).padStart(2, "0")}</p>
              <h3>{section.title}</h3>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </section>
          ))}
        </div>
      </section>

      {chapter.equations.length ? (
        <section id="equations" class="lesson-section" aria-labelledby="equations-title">
          <p class="instrument-label">05 · Compress the relationships</p>
          <h2 id="equations-title">Equations after the quantities have jobs</h2>
          <div class="longform-prose section-lead"><p>The notation below does not start a new story. Each symbol points back to the situation, diagram, or worked calculation above.</p></div>
          <div class="formula-list">
            {chapter.equations.map((equation) => (
              <article>
                <div class="formula-render" set:html={katex.renderToString(equation.latex, { displayMode: true, throwOnError: true })} />
                <p><strong>{equation.read}</strong></p>
                <p>{equation.meaning}</p>
              </article>
            ))}
          </div>
        </section>
      ) : null}

      <section id="boundary" class="lesson-section boundary-section" aria-labelledby="boundary-title">
        <p class="instrument-label">06 · Where it stops working</p>
        <h2 id="boundary-title">{chapter.boundary.title}</h2>
        <div class="longform-prose">{chapter.boundary.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
      </section>

      <section class="lesson-references" aria-labelledby="sources-title">
        <p class="instrument-label">Original and official sources</p>
        <h2 id="sources-title">Continue beyond the field guide</h2>
        <ul>{chapter.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer"><span>{source.label}<small>{source.kind}</small></span><span aria-hidden="true">↗</span></a></li>)}</ul>
      </section>

      <nav class="lesson-next" aria-label="Chapter pagination">
        {previous ? <a href={`${base}/en/learn/${previous.slug}/`}><small>← Previous</small><strong>{previous.title}</strong></a> : <a href={homeHref}><small>← Complete field map</small><strong>RL Field Guide</strong></a>}
        {next ? <a class="next-link" href={`${base}/en/learn/${next.slug}/`}><small>Next →</small><strong>{next.title}</strong><span>{chapter.nextBridge}</span></a> : <a class="next-link" href={homeHref}><small>Return to field map →</small><strong>Choose a route to revisit</strong><span>{chapter.nextBridge}</span></a>}
      </nav>
    </article>
  </main>
  <script is:inline>document.querySelector('.lesson-rail-links [aria-current="page"]')?.scrollIntoView({ block: "center", inline: "nearest" });</script>
</GuideLayout>
