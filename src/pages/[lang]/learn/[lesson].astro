---
import katex from "katex";
import GuideHeader from "@/components/GuideHeader.astro";
import LessonDiagram from "@/components/LessonDiagram.astro";
import StaticEvidence from "@/components/StaticEvidence.astro";
import { COURSE, LANGUAGES, LESSON_IDS, type Language, type LessonId } from "@/content/bilingual-course";
import { getLearningLab } from "@/content/learning-labs";
import GuideLayout from "@/layouts/GuideLayout.astro";

export function getStaticPaths() {
  return LANGUAGES.flatMap((language) => LESSON_IDS.map((lessonId) => ({
    params: { lang: language, lesson: lessonId },
    props: { language, lessonId },
  })));
}

const { language, lessonId } = Astro.props as { language: Language; lessonId: LessonId };
const course = COURSE[language];
const lessonIndex = course.lessons.findIndex((item) => item.id === lessonId);
const lesson = course.lessons[lessonIndex];
const alternateLanguage: Language = language === "en" ? "zh" : "en";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeHref = `${base}/${language}/`;
const lessonHref = `${base}/${language}/learn/${lesson.id}/`;
const previous = course.lessons[lessonIndex - 1];
const next = course.lessons[lessonIndex + 1];
const prerequisites = lesson.prerequisites.map((id) => course.lessons.find((item) => item.id === id)).filter(Boolean);
const reading = getLearningLab(language, lesson.id);
const chapterBridge = previous
  ? language === "zh"
    ? `上一课先解决了“${previous.title}”。这一课沿着同一条因果链往前走：${lesson.subtitle}`
    : `The previous chapter established ${previous.title.toLowerCase()}. This chapter follows the same causal thread: ${lesson.subtitle}`
  : language === "zh"
    ? "这一课先不讲算法。我们从任务本身开始，判断它是否真的需要从连续后果中学习。"
    : "This first chapter does not begin with an algorithm. It begins by asking whether the task actually requires learning from a sequence of consequences.";
---

<GuideLayout title={`${lesson.title} · ${course.brand}`} description={lesson.outcome} language={language} canonicalPath={lessonHref} alternatePath={`${base}/${alternateLanguage}/learn/${lesson.id}/`}>
  <GuideHeader language={language} brand={course.brand} homeHref={homeHref} alternateHref={`${base}/${alternateLanguage}/learn/${lesson.id}/`} alternateLabel={course.labels.language} themeLabel={course.labels.theme} />

  <main id="main-content" class="lesson-shell" tabindex="-1">
    <aside class="lesson-rail" aria-label={course.routeLabel}>
      <a class="rail-home" href={homeHref}>← {course.labels.courseMap}</a>
      <p class="instrument-label">{course.routeLabel}</p>
      <nav class="lesson-rail-links">
        {course.lessons.map((item, index) => (
          <a data-lesson-id={item.id} href={`${base}/${language}/learn/${item.id}/`} aria-current={item.id === lesson.id ? "page" : undefined}>
            <span>{String(index + 1).padStart(2, "0")}</span><em>{item.title}</em>
          </a>
        ))}
      </nav>
      <div class="lesson-mobile-current">
        {previous ? <a href={`${base}/${language}/learn/${previous.id}/`} aria-label={`${course.labels.previous}: ${previous.title}`}>←</a> : <span aria-hidden="true">·</span>}
        <strong>{String(lessonIndex + 1).padStart(2, "0")} / {course.lessons.length}<small>{lesson.title}</small></strong>
        {next ? <a href={`${base}/${language}/learn/${next.id}/`} aria-label={`${course.labels.next}: ${next.title}`}>→</a> : <span aria-hidden="true">·</span>}
      </div>
      <details class="lesson-mobile-menu">
        <summary>{language === "zh" ? "展开全部课程" : "Open all lessons"}</summary>
        <nav>{course.lessons.map((item, index) => <a href={`${base}/${language}/learn/${item.id}/`} aria-current={item.id === lesson.id ? "page" : undefined}><span>{String(index + 1).padStart(2, "0")}</span>{item.title}</a>)}</nav>
      </details>
    </aside>

    <article class="lesson-article">
      <header class="lesson-intro">
        <div class="lesson-meta"><span>{lesson.stage}</span><span>{course.labels.lesson} {String(lessonIndex + 1).padStart(2, "0")} / {course.lessons.length}</span></div>
        <h1>{lesson.title}</h1>
        <p class="lesson-subtitle">{lesson.subtitle}</p>
        <blockquote>{lesson.openingQuestion}</blockquote>
        <dl class="lesson-contract">
          <div><dt>{course.labels.prerequisites}</dt><dd>{prerequisites.length ? prerequisites.map((item, index) => <><a href={`${base}/${language}/learn/${item!.id}/`}>{item!.title}</a>{index < prerequisites.length - 1 ? " · " : ""}</>) : course.labels.none}</dd></div>
          <div><dt>{course.labels.outcome}</dt><dd>{lesson.outcome}</dd></div>
        </dl>
        <div class="foundation-note"><div><strong>{language === "zh" ? "本课必须会" : "Required for this lesson"}</strong><p>{reading.foundation.required}</p></div><div><strong>{language === "zh" ? "可以先跳过" : "Safe to postpone"}</strong><p>{reading.foundation.optional}</p></div></div>
      </header>

      <nav class="lesson-sections" aria-label={language === "zh" ? "本课章节" : "Lesson sections"}>
        <a href="#scenario">{language === "zh" ? "情境" : "Scenario"}</a><a href="#diagram">{language === "zh" ? "图解" : "Diagram"}</a><a href="#example">{language === "zh" ? "例子" : "Example"}</a><a href="#ideas-title">{language === "zh" ? "概念" : "Ideas"}</a>{lesson.formulas.length > 0 ? <a href="#formula-title">{language === "zh" ? "公式" : "Equation"}</a> : null}<a href="#check-title">{language === "zh" ? "边界" : "Boundary"}</a>
      </nav>

      <section id="scenario" class="lesson-section story-section" aria-labelledby="story-title">
        <p class="instrument-label">01 · {course.labels.story}</p>
        <h2 id="story-title">{language === "zh" ? "这一课为什么接在这里" : "Why this question comes next"}</h2>
        <div class="longform-prose">
          <p class="chapter-bridge">{chapterBridge}</p>
          <p>{lesson.story}</p>
          <p>{language === "zh"
            ? `先别急着记“${lesson.concepts[0].title}”这样的名字。下面的图会把参与者、信息和后果放在同一个画面里；随后再用数字走一遍，概念才会正式出现。`
            : `Do not memorize names such as “${lesson.concepts[0].title}” yet. The diagram below puts the actors, information, and consequences in one view. A worked example will then make the relationship concrete before the terminology is introduced.`}</p>
        </div>
      </section>

      <section id="diagram" class="lesson-section diagram-section">
        <LessonDiagram language={language} lessonId={lesson.id} />
      </section>

      <section id="example" class="lesson-section" aria-labelledby="examples-title">
        <p class="instrument-label">03 · {course.labels.examples}</p>
        <h2 id="examples-title">{language === "zh" ? "用一组数字把图里的关系走一遍" : "Walk through the diagram with concrete numbers"}</h2>
        <div class="longform-prose section-lead">
          <p>{language === "zh"
            ? "图示说明各部分怎样相连，数字例子则负责暴露每一步到底用了什么。计算会完整展开；答案直接写在页面上，不需要点击揭晓。"
            : "The diagram shows how the pieces connect. The worked example now exposes what each step actually uses. Every calculation stays visible on the page; there is nothing to unlock."}</p>
        </div>
        <StaticEvidence language={language} reading={reading} />
        <div class="example-continuation longform-prose">
          {lesson.examples.slice(1).map((example, exampleIndex) => (
            <section class="prose-subsection">
              <p class="prose-kicker">{language === "zh" ? "换一个情境" : "A second situation"} · {String(exampleIndex + 1).padStart(2, "0")}</p>
              <h3>{example.title}</h3>
              <p>{example.setup}</p>
              <ol>{example.steps.map((step) => <li>{step}</li>)}</ol>
              <p><strong>{language === "zh" ? "结果：" : "Result: "}</strong>{example.result}</p>
            </section>
          ))}
        </div>
      </section>

      <section class="lesson-section" aria-labelledby="ideas-title">
        <p class="instrument-label">04 · {course.labels.ideas}</p>
        <h2 id="ideas-title">{language === "zh" ? "现在再给刚才的关系命名" : "Now name the relationships you have already used"}</h2>
        <div class="longform-prose">
          <p>{language === "zh"
            ? "前面的场景、图示和计算已经把机制走完了。下面这些术语只是为已经看见的关系提供稳定名称，方便后续章节继续使用。"
            : "The situation, diagram, and calculation have already exposed the mechanism. The terms below give stable names to those relationships so later chapters can reuse them without starting over."}</p>
          {lesson.concepts.map((concept, index) => (
            <section class="prose-subsection">
              <p class="prose-kicker">{String(index + 1).padStart(2, "0")}</p>
              <h3>{concept.title}</h3>
              <p>{concept.body}</p>
            </section>
          ))}
        </div>
      </section>

      {lesson.formulas.length > 0 ? (
        <section class="lesson-section" aria-labelledby="formula-title">
          <p class="instrument-label">05 · {course.labels.formula}</p>
          <h2 id="formula-title">{language === "zh" ? "公式压缩的是你刚看过的因果步骤" : "The equation compresses the causal steps you just saw"}</h2>
          <div class="longform-prose section-lead">
            <p>{language === "zh"
              ? "公式不会带来一套新的故事。它把已经出现的数量和关系压成一种可以检查、推导和实现的写法；读公式时仍然可以逐项指回上面的例子。"
              : "The equation does not introduce a second story. It compresses quantities and relationships that have already appeared into a form that can be checked, derived, and implemented. Each symbol should still point back to the example above."}</p>
          </div>
          <div class="formula-list">
            {lesson.formulas.map((formula) => (
              <article>
                <div class="formula-render" set:html={katex.renderToString(formula.latex, { displayMode: true, throwOnError: false })} />
                <p><strong>{formula.read}</strong></p>
                <p>{formula.meaning}</p>
              </article>
            ))}
          </div>
        </section>
      ) : null}

      <section id="check-title" class="lesson-section boundary-section" aria-label={course.labels.misconception}>
        <p class="instrument-label">06 · {course.labels.misconception}</p>
        <h2>{language === "zh" ? "这个结论到哪里会失效" : "Where this conclusion stops working"}</h2>
        <div class="longform-prose">
          <p>{language === "zh"
            ? "一个方法只有在前提成立时才有意义。读完本课前，把下面这条边界和刚才的成功例子放在一起看。"
            : "A method is useful only while its assumptions hold. Before leaving the chapter, read this boundary beside the successful example above."}</p>
        </div>
        <article class="trap-card"><h3>{lesson.title}</h3><p>{lesson.misconception}</p></article>
      </section>

      {lesson.references?.length ? (
        <section class="lesson-references" aria-labelledby="references-title">
          <p class="instrument-label">{language === "zh" ? "原始资料" : "Primary sources"}</p>
          <h2 id="references-title">{language === "zh" ? "继续沿原论文深入" : "Continue with the original work"}</h2>
          <ul>{lesson.references.map((reference) => <li><a href={reference.url} target="_blank" rel="noreferrer">{reference.label}<span>↗</span></a></li>)}</ul>
        </section>
      ) : null}

      <nav class="lesson-next" aria-label={language === "zh" ? "课程翻页" : "Lesson pagination"}>
        {previous ? <a href={`${base}/${language}/learn/${previous.id}/`}><small>← {course.labels.previous}</small><strong>{previous.title}</strong></a> : <a href={homeHref}><small>← {course.labels.courseMap}</small><strong>{course.title}</strong></a>}
        {next ? <a class="next-link" href={`${base}/${language}/learn/${next.id}/`}><small>{course.labels.next} →</small><strong>{next.title}</strong><span>{lesson.nextReason}</span></a> : <a class="next-link" href={homeHref}><small>{course.labels.courseMap} →</small><strong>{course.title}</strong></a>}
      </nav>
    </article>
  </main>
  <script is:inline>document.querySelector('.lesson-rail-links [aria-current="page"]')?.scrollIntoView({ block: "center", inline: "nearest" });</script>
</GuideLayout>
