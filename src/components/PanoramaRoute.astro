---
import type { PanoramaMovement } from "@/content/panorama/types";

interface Props {
  movements: readonly PanoramaMovement[];
  label: string;
}

const { movements, label } = Astro.props;
---

<figure class="panorama-route" aria-labelledby="panorama-route-title">
  <figcaption id="panorama-route-title">{label}</figcaption>
  <ol>
    {movements.map((movement) => (
      <li>
        <span>{movement.number}</span>
        <strong>{movement.title}</strong>
      </li>
    ))}
  </ol>
</figure>
