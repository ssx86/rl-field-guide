---
import katex from "katex";
import type { ChapterArticle } from "@/content/chapter-article";

interface Props {
  diagram: ChapterArticle["diagram"];
  slug: string;
  label?: string;
}

const { diagram, slug, label = "Core diagram" } = Astro.props;
const variant = diagram.variant ?? "flow";
---

<figure class:list={["knowledge-diagram", `diagram-${variant}`]} aria-labelledby={`diagram-title-${slug}`}>
  <header>
    <div>
      <p class="instrument-label">{label}</p>
      <h2 id={`diagram-title-${slug}`}>{diagram.title}</h2>
    </div>
  </header>
  <ol class="diagram-items">
    {diagram.items.map((item, index) => (
      <li>
        <div class="diagram-method">
          <span class="diagram-index">{String(index + 1).padStart(2, "0")}</span>
          <strong>{item.label}</strong>
        </div>
        <div class="diagram-copy">
          {item.latex ? (
            <div class="diagram-formula" aria-label={item.value}>
              <span aria-hidden="true" set:html={katex.renderToString(item.latex, { displayMode: true, throwOnError: true })} />
            </div>
          ) : <b>{item.value}</b>}
          <small>{item.note}</small>
        </div>
      </li>
    ))}
  </ol>
  <figcaption>{diagram.caption}</figcaption>
</figure>
