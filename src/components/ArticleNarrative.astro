---
import katex from "katex";

import ArticleDiagram from "@/components/ArticleDiagram.astro";
import KnowledgeText from "@/components/KnowledgeText.astro";
import LinkedHeading from "@/components/LinkedHeading.astro";
import type { ChapterArticle } from "@/content/chapter-article";
import { createKnowledgeAnnotator } from "@/content/knowledge-text";
import type { ReadingMode } from "@/content/reading-mode";

interface Labels {
  readonly sections: string;
  readonly diagram: string;
  readonly example: string;
  readonly pause: string;
  readonly result: string;
  readonly equationsTitle: string;
  readonly equationLead: string;
  readonly boundary: string;
}

interface Props {
  readonly chapter: ChapterArticle;
  readonly slug: string;
  readonly labels: Labels;
  readonly mode: ReadingMode;
  readonly base: string;
}

const { chapter, slug, labels, mode, base } = Astro.props;
const blocks = chapter.narrative ?? [];
const language = mode === "zh" ? "zh" : "en";
const annotate = createKnowledgeAnnotator(language);
---

{blocks.map((block) => (
  block.type === "section" ? (
    <section id={block.id} class="lesson-section narrative-section" aria-labelledby={`${block.id}-title`}>
      <LinkedHeading id={`${block.id}-title`} hash={block.id} label={block.title} copyLabel={language === "zh" ? "复制本节链接" : "Copy link to this section"}>{block.title}</LinkedHeading>
      <div class="longform-prose">{block.paragraphs.map((paragraph) => <p><KnowledgeText segments={annotate(paragraph, block.id)} language={language} mode={mode} base={base} /></p>)}</div>
    </section>
  ) : block.type === "diagram" ? (
    <section id="diagram" class="lesson-section diagram-section">
      {labels.diagram ? <ArticleDiagram diagram={chapter.diagram} slug={slug} label={labels.diagram} /> : <ArticleDiagram diagram={chapter.diagram} slug={slug} label={""} />}
    </section>
  ) : block.type === "worked-example" ? (
    <section id="example" class="lesson-section" aria-labelledby="example-title">
      {labels.example ? <p class="instrument-label">{labels.example}</p> : null}
      <LinkedHeading id="example-title" hash="example" label={chapter.workedExample.title} copyLabel={language === "zh" ? "复制本节链接" : "Copy link to this section"}>{chapter.workedExample.title}</LinkedHeading>
      <div class="longform-prose section-lead"><p><KnowledgeText segments={annotate(chapter.workedExample.setup, "example")} language={language} mode={mode} base={base} /></p></div>
      <article class="static-evidence">
        <header>
          <p class="instrument-label">{labels.pause}</p>
          <h3>{chapter.workedExample.prediction}</h3>
        </header>
        <ol class="static-evidence-steps">
          {chapter.workedExample.steps.map((step, index) => (
            <li><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{step.label}</strong><code>{step.calculation}</code><p><KnowledgeText segments={annotate(step.explanation, "example")} language={language} mode={mode} base={base} /></p></div></li>
          ))}
        </ol>
        <p class="worked-result">{labels.result ? <strong>{labels.result}</strong> : null}{chapter.workedExample.result}</p>
      </article>
    </section>
  ) : block.type === "equations" ? (
    chapter.equations.length ? (
      <section id="equations" class="lesson-section" aria-labelledby="equations-title">
        <LinkedHeading id="equations-title" hash="equations" label={labels.equationsTitle} copyLabel={language === "zh" ? "复制本节链接" : "Copy link to this section"}>{labels.equationsTitle}</LinkedHeading>
        <div class="longform-prose section-lead"><p><KnowledgeText segments={annotate(labels.equationLead, "equations")} language={language} mode={mode} base={base} /></p></div>
        <div class="formula-list">
          {chapter.equations.map((equation) => (
            <article>
              <div class="formula-render" set:html={katex.renderToString(equation.latex, { displayMode: true, throwOnError: true })} />
              <p><strong><KnowledgeText segments={annotate(equation.read, "equations")} language={language} mode={mode} base={base} /></strong></p>
              <p><KnowledgeText segments={annotate(equation.meaning, "equations")} language={language} mode={mode} base={base} /></p>
            </article>
          ))}
        </div>
      </section>
    ) : null
  ) : (
    <section id="boundary" class="lesson-section boundary-section" aria-labelledby="boundary-title">
      <LinkedHeading id="boundary-title" hash="boundary" label={chapter.boundary.title} copyLabel={language === "zh" ? "复制本节链接" : "Copy link to this section"}>{chapter.boundary.title}</LinkedHeading>
      <div class="longform-prose">{chapter.boundary.paragraphs.map((paragraph) => <p><KnowledgeText segments={annotate(paragraph, "boundary")} language={language} mode={mode} base={base} /></p>)}</div>
    </section>
  )
))}
