---
import type { Language } from "@/content/bilingual-course";

interface Props {
  language: Language;
  brand: string;
  alternateHref: string;
  alternateLabel: string;
  homeHref: string;
  themeLabel: string;
}

const { language, brand, alternateHref, alternateLabel, homeHref, themeLabel } = Astro.props;
const darkLabel = language === "zh" ? "切换到暗色" : "Switch to dark";
const lightLabel = language === "zh" ? "切换到亮色" : "Switch to light";
---

<header class="guide-header">
  <a class="guide-brand" href={homeHref} aria-label={`${brand} home`}>
    <span class="guide-brand-mark" aria-hidden="true">RL</span>
    <span>{brand}</span>
  </a>
  <div class="guide-header-actions">
    <a class="guide-control" href={alternateHref}>{alternateLabel}</a>
    <button class="guide-control theme-control" type="button" data-theme-toggle data-dark-label={darkLabel} data-light-label={lightLabel} aria-label={themeLabel} aria-pressed="false">{darkLabel}</button>
  </div>
</header>
