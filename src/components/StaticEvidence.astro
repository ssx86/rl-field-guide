---
import type { LearningLabCopy } from "@/content/learning-labs";

interface Props { language: "en" | "zh"; reading: LearningLabCopy }
const { language, reading } = Astro.props;
const zh = language === "zh";
const correctChoice = reading.prediction.choices[reading.prediction.correct];
const transferChoice = reading.transfer.choices[reading.transfer.correct];
---

<article class="static-evidence">
  <header>
    <p class="instrument-label">{zh ? "数字例子" : "Worked numeric example"}</p>
    <h3>{reading.evidence.title}</h3>
    <p>{reading.evidence.setup}</p>
  </header>
  <div class="reading-question">
    <span>{zh ? "先停一秒想一想" : "Pause for one prediction"}</span>
    <strong>{reading.prediction.prompt}</strong>
    <p><b>{zh ? "判断：" : "Answer: "}{correctChoice}</b> {reading.prediction.explanation}</p>
  </div>
  <ol class="static-evidence-steps">
    {reading.evidence.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{step}</p></li>)}
  </ol>
  <p class="static-result"><strong>{zh ? "结论" : "Result"}</strong>{reading.evidence.result}</p>
  <aside class="reading-transfer">
    <span>{zh ? "换一个情境" : "Change the situation"}</span>
    <h3>{reading.transfer.prompt}</h3>
    <p><b>{zh ? "判断：" : "Answer: "}{transferChoice}</b> {reading.transfer.explanation}</p>
  </aside>
</article>
