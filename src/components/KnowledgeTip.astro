---
import { Graph, Lightbulb, WarningCircle } from "@phosphor-icons/react";

interface Props {
  readonly variant: "definition" | "connection" | "warning";
  readonly title: string;
}

const { variant, title } = Astro.props;
const Icon = variant === "warning" ? WarningCircle : variant === "connection" ? Graph : Lightbulb;
---

<aside class:list={["knowledge-tip", `knowledge-tip-${variant}`]}>
  <Icon size={19} weight="regular" aria-hidden="true" />
  <div><strong>{title}</strong><slot /></div>
</aside>
