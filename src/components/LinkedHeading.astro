---
import { LinkSimple } from "@phosphor-icons/react";

interface Props {
  readonly id: string;
  readonly label: string;
  readonly copyLabel?: string;
  readonly hash?: string;
}

const { id, label, copyLabel = "Copy link to this section", hash = id } = Astro.props;
---

<h2 id={id} class="anchored-heading">
  <a class="heading-anchor" href={`#${hash}`} aria-label={`${copyLabel}: ${label}`} data-heading-anchor>
    <LinkSimple size={17} weight="regular" aria-hidden="true" />
  </a>
  <span><slot /></span>
</h2>
