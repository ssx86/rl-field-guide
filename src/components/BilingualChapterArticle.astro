---
import katex from "katex";

import ArticleDiagram from "@/components/ArticleDiagram.astro";
import KnowledgeText from "@/components/KnowledgeText.astro";
import LinkedHeading from "@/components/LinkedHeading.astro";
import type { ChapterArticle } from "@/content/chapter-article";
import { createKnowledgeAnnotator } from "@/content/knowledge-text";

interface Props {
  readonly english: ChapterArticle;
  readonly chinese: ChapterArticle;
  readonly slug: string;
  readonly base: string;
}

const { english, chinese, slug, base } = Astro.props;
const pair = <T, U>(left: readonly T[], right: readonly U[]) =>
  Array.from({ length: Math.max(left.length, right.length) }, (_, index) => ({ left: left[index], right: right[index] }));
const annotateEn = createKnowledgeAnnotator("en");
const annotateZh = createKnowledgeAnnotator("zh");
---

<section id="situation" class="lesson-section bilingual-section" aria-labelledby="situation-title">
  <p class="instrument-label">SITUATION / 情境</p>
  <LinkedHeading id="situation-title" hash="situation" label={english.situation.title}>{english.situation.title}</LinkedHeading>
  <h3 lang="zh-CN">{chinese.situation.title}</h3>
  <div class="longform-prose bilingual-prose">
    <div class="language-pair"><span class="language-marker" aria-hidden="true">EN</span><p lang="en"><KnowledgeText segments={annotateEn(english.bridge, "situation")} language="en" mode="bilingual" base={base} /></p><span class="language-marker" aria-hidden="true">中</span><p lang="zh-CN"><KnowledgeText segments={annotateZh(chinese.bridge, "situation")} language="zh" mode="bilingual" base={base} /></p></div>
    {pair(english.situation.paragraphs, chinese.situation.paragraphs).map(({ left, right }) => (
      <div class="language-pair">
        {left ? <><span class="language-marker" aria-hidden="true">EN</span><p lang="en"><KnowledgeText segments={annotateEn(left, "situation")} language="en" mode="bilingual" base={base} /></p></> : null}
        {right ? <><span class="language-marker" aria-hidden="true">中</span><p lang="zh-CN"><KnowledgeText segments={annotateZh(right, "situation")} language="zh" mode="bilingual" base={base} /></p></> : null}
      </div>
    ))}
  </div>
</section>

<section id="diagram" class="lesson-section diagram-section bilingual-section">
  <ArticleDiagram diagram={english.diagram} slug={slug} label="DIAGRAM / 图解" />
  <div class="bilingual-caption" lang="zh-CN"><span class="language-marker" aria-hidden="true">中</span><strong>{chinese.diagram.title}</strong><p>{chinese.diagram.caption}</p></div>
</section>

<section id="example" class="lesson-section bilingual-section" aria-labelledby="example-title">
  <p class="instrument-label">WORKED EXAMPLE / 完整算例</p>
  <LinkedHeading id="example-title" hash="example" label={english.workedExample.title}>{english.workedExample.title}</LinkedHeading>
  <h3 lang="zh-CN">{chinese.workedExample.title}</h3>
  <div class="language-pair compact"><span class="language-marker" aria-hidden="true">EN</span><p lang="en"><KnowledgeText segments={annotateEn(english.workedExample.setup, "example")} language="en" mode="bilingual" base={base} /></p><span class="language-marker" aria-hidden="true">中</span><p lang="zh-CN"><KnowledgeText segments={annotateZh(chinese.workedExample.setup, "example")} language="zh" mode="bilingual" base={base} /></p></div>
  <article class="static-evidence">
    <header>
      <p class="instrument-label">PAUSE AND PREDICT / 先预测</p>
      <div class="language-pair compact"><span class="language-marker" aria-hidden="true">EN</span><h3 lang="en">{english.workedExample.prediction}</h3><span class="language-marker" aria-hidden="true">中</span><h3 lang="zh-CN">{chinese.workedExample.prediction}</h3></div>
    </header>
    <ol class="static-evidence-steps">
      {pair(english.workedExample.steps, chinese.workedExample.steps).map(({ left, right }, index) => (
        <li><span>{String(index + 1).padStart(2, "0")}</span><div>
          {left ? <div lang="en"><strong><i class="language-marker">EN</i>{left.label}</strong><code>{left.calculation}</code><p><KnowledgeText segments={annotateEn(left.explanation, "example")} language="en" mode="bilingual" base={base} /></p></div> : null}
          {right ? <div class="paired-step" lang="zh-CN"><strong><i class="language-marker">中</i>{right.label}</strong><code>{right.calculation}</code><p><KnowledgeText segments={annotateZh(right.explanation, "example")} language="zh" mode="bilingual" base={base} /></p></div> : null}
        </div></li>
      ))}
    </ol>
    <div class="worked-result language-pair compact"><span class="language-marker" aria-hidden="true">EN</span><p lang="en">{english.workedExample.result}</p><span class="language-marker" aria-hidden="true">中</span><p lang="zh-CN">{chinese.workedExample.result}</p></div>
  </article>
</section>

<section id="mechanism" class="lesson-section bilingual-section" aria-labelledby="mechanism-title">
  <p class="instrument-label">MECHANISM / 机制</p>
  <LinkedHeading id="mechanism-title" hash="mechanism" label={english.mechanism.introduction}>{english.mechanism.introduction}</LinkedHeading>
  <h3 lang="zh-CN">{chinese.mechanism.introduction}</h3>
  <div class="longform-prose mechanism-prose bilingual-prose">
    {pair(english.mechanism.sections, chinese.mechanism.sections).map(({ left, right }, index) => (
      <section class="bilingual-passage">
        {left ? <><h4 lang="en"><span class="language-marker" aria-hidden="true">EN</span>{left.title}</h4>{left.paragraphs.map((paragraph) => <p lang="en"><KnowledgeText segments={annotateEn(paragraph, `mechanism-${index}`)} language="en" mode="bilingual" base={base} /></p>)}</> : null}
        {right ? <><h4 lang="zh-CN"><span class="language-marker" aria-hidden="true">中</span>{right.title}</h4>{right.paragraphs.map((paragraph) => <p lang="zh-CN"><KnowledgeText segments={annotateZh(paragraph, `mechanism-${index}`)} language="zh" mode="bilingual" base={base} /></p>)}</> : null}
      </section>
    ))}
  </div>
</section>

{english.equations.length ? (
  <section id="equations" class="lesson-section bilingual-section" aria-labelledby="equations-title">
    <p class="instrument-label">EQUATIONS / 公式</p>
    <LinkedHeading id="equations-title" hash="equations" label="One relationship, read twice">One relationship, read twice</LinkedHeading>
    <h3 lang="zh-CN">同一条关系，用两种语言读</h3>
    <div class="formula-list">
      {english.equations.map((equation, index) => (
        <article>
          <div class="formula-render" set:html={katex.renderToString(equation.latex, { displayMode: true, throwOnError: true })} />
          <div class="language-pair compact"><span class="language-marker" aria-hidden="true">EN</span><div lang="en"><p><strong><KnowledgeText segments={annotateEn(equation.read, "equations")} language="en" mode="bilingual" base={base} /></strong></p><p><KnowledgeText segments={annotateEn(equation.meaning, "equations")} language="en" mode="bilingual" base={base} /></p></div><span class="language-marker" aria-hidden="true">中</span><div lang="zh-CN"><p><strong><KnowledgeText segments={annotateZh(chinese.equations[index].read, "equations")} language="zh" mode="bilingual" base={base} /></strong></p><p><KnowledgeText segments={annotateZh(chinese.equations[index].meaning, "equations")} language="zh" mode="bilingual" base={base} /></p></div></div>
        </article>
      ))}
    </div>
  </section>
) : null}

<section id="boundary" class="lesson-section boundary-section bilingual-section" aria-labelledby="boundary-title">
  <p class="instrument-label">BOUNDARY / 边界</p>
  <LinkedHeading id="boundary-title" hash="boundary" label={english.boundary.title}>{english.boundary.title}</LinkedHeading>
  <h3 lang="zh-CN">{chinese.boundary.title}</h3>
  <div class="longform-prose bilingual-prose">
    {pair(english.boundary.paragraphs, chinese.boundary.paragraphs).map(({ left, right }) => (
      <div class="language-pair">{left ? <><span class="language-marker" aria-hidden="true">EN</span><p lang="en"><KnowledgeText segments={annotateEn(left, "boundary")} language="en" mode="bilingual" base={base} /></p></> : null}{right ? <><span class="language-marker" aria-hidden="true">中</span><p lang="zh-CN"><KnowledgeText segments={annotateZh(right, "boundary")} language="zh" mode="bilingual" base={base} /></p></> : null}</div>
    ))}
  </div>
</section>
