---
import KnowledgeTermLink from "@/components/KnowledgeTermLink.astro";
import type { KnowledgeLanguage } from "@/content/knowledge-graph";
import type { KnowledgeSegment } from "@/content/knowledge-text";
import type { ReadingMode } from "@/content/reading-mode";

interface Props {
  readonly segments: readonly KnowledgeSegment[];
  readonly language: KnowledgeLanguage;
  readonly mode: ReadingMode;
  readonly base: string;
}

const { segments, language, mode, base } = Astro.props;
---

{segments.map((segment) => segment.kind === "term"
  ? <KnowledgeTermLink termId={segment.termId} text={segment.text} language={language} mode={mode} base={base} />
  : segment.kind === "chapter-link"
    ? <a class="knowledge-link knowledge-link-chapter" href={`${base}/${mode}/learn/${segment.slug}/`}>{segment.text}<span aria-hidden="true">→</span></a>
    : segment.text)}
