---
import KnowledgeText from "@/components/KnowledgeText.astro";
import type { KnowledgeLanguage } from "@/content/knowledge-graph";
import type { KnowledgeSegment } from "@/content/knowledge-text";
import type { ReadingMode } from "@/content/reading-mode";

interface Props {
  readonly segments: readonly KnowledgeSegment[];
  readonly base: string;
  readonly mode: ReadingMode;
  readonly language: KnowledgeLanguage;
}

const { segments, base, mode, language } = Astro.props;
---

<p><KnowledgeText segments={segments} base={base} mode={mode} language={language} /></p>
