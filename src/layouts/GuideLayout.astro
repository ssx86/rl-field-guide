---
import "@/styles/guide-base.css";
import "@/styles/guide.css";
import "katex/dist/katex.min.css";
import type { Language } from "@/content/bilingual-course";

interface Props {
  title: string;
  description: string;
  language: Language;
  canonicalPath: string;
  alternatePath?: string;
}

const { title, description, language, canonicalPath, alternatePath } = Astro.props;
const htmlLang = language === "zh" ? "zh-CN" : "en";
const canonical = new URL(canonicalPath, Astro.site);
const alternate = alternatePath ? new URL(alternatePath, Astro.site) : undefined;
const alternateLang = language === "zh" ? "en" : "zh-CN";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f6f4" data-theme-color />
    <link rel="canonical" href={canonical} />
    {alternate ? <link rel="alternate" hreflang={alternateLang} href={alternate} /> : null}
    <link rel="alternate" hreflang={htmlLang} href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem("rl-field-guide-theme");
        const theme = saved === "dark" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector('meta[data-theme-color]')?.setAttribute('content', theme === 'dark' ? '#111614' : '#f5f6f4');
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{language === "zh" ? "跳到主要内容" : "Skip to main content"}</a>
    <slot />
    <script is:inline>
      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          document.documentElement.style.colorScheme = next;
          const isDark = next === "dark";
          button.setAttribute("aria-pressed", String(isDark));
          const label = isDark ? button.dataset.lightLabel : button.dataset.darkLabel;
          if (label) { button.setAttribute("aria-label", label); button.textContent = label; }
          document.querySelector('meta[data-theme-color]')?.setAttribute('content', isDark ? '#111614' : '#f5f6f4');
          try { localStorage.setItem("rl-field-guide-theme", next); } catch {}
        });
      });
      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        const isDark = document.documentElement.dataset.theme === "dark";
        button.setAttribute("aria-pressed", String(isDark));
        const label = isDark ? button.dataset.lightLabel : button.dataset.darkLabel;
        if (label) { button.setAttribute("aria-label", label); button.textContent = label; }
      });
    </script>
  </body>
</html>
