---
import "@/styles.css";
import "@/styles/guide.css";
import "katex/dist/katex.min.css";
import type { Language } from "@/content/bilingual-course";

interface Props {
  title: string;
  description: string;
  language: Language;
  canonicalPath: string;
}

const { title, description, language, canonicalPath } = Astro.props;
const htmlLang = language === "zh" ? "zh-CN" : "en";
const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f6f4" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem("rl-field-guide-theme");
        const theme = saved === "dark" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          document.documentElement.style.colorScheme = next;
          try { localStorage.setItem("rl-field-guide-theme", next); } catch {}
        });
      });
    </script>
  </body>
</html>
