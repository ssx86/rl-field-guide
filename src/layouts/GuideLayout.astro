---
import "@/styles/guide-base.css";
import "@/styles/guide.css";
import "katex/dist/katex.min.css";
import { KnowledgeLayer } from "@/components/KnowledgeLayer";
import type { ReadingMode } from "@/content/reading-mode";

interface Props {
  title: string;
  description: string;
  mode: ReadingMode;
  canonicalPath: string;
  alternatePaths?: readonly { hreflang: string; path: string }[];
  languageHashMode?: "shared" | "all";
  knowledgeSlug?: string;
}

const { title, description, mode, canonicalPath, alternatePaths = [], languageHashMode = "shared", knowledgeSlug } = Astro.props;
const htmlLang = mode === "zh" ? "zh-CN" : "en";
const canonical = new URL(canonicalPath, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f6f4" data-theme-color />
    <link rel="canonical" href={canonical} />
    {alternatePaths.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={new URL(alternate.path, Astro.site)} />)}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem("rl-field-guide-theme");
        const theme = saved === "dark" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector('meta[data-theme-color]')?.setAttribute('content', theme === 'dark' ? '#111614' : '#f5f6f4');
      } catch {}
    </script>
  </head>
  <body data-language-hash-mode={languageHashMode}>
    <a class="skip-link" href="#main-content">{mode === "zh" ? "跳到主要内容" : mode === "bilingual" ? "Skip to content / 跳到正文" : "Skip to main content"}</a>
    <slot />
    {knowledgeSlug ? <KnowledgeLayer mode={mode} currentSlug={knowledgeSlug} base={base} client:load /> : null}
    <script is:inline>
      const syncLanguageToggleHashes = () => document.querySelectorAll("[data-language-toggle]").forEach((link) => {
        const sharedChapterAnchors = new Set(["#diagram", "#example", "#equations", "#boundary"]);
        if (!(link instanceof HTMLAnchorElement)) return;
        const target = new URL(link.href);
        target.hash = "";
        if (document.body.dataset.languageHashMode === "all" || sharedChapterAnchors.has(location.hash)) target.hash = location.hash;
        link.href = target.toString();
      });
      syncLanguageToggleHashes();
      window.addEventListener("hashchange", syncLanguageToggleHashes);
      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          document.documentElement.style.colorScheme = next;
          const isDark = next === "dark";
          button.setAttribute("aria-pressed", String(isDark));
          const label = isDark ? button.dataset.lightLabel : button.dataset.darkLabel;
          if (label) { button.setAttribute("aria-label", label); button.textContent = label; }
          document.querySelector('meta[data-theme-color]')?.setAttribute('content', isDark ? '#111614' : '#f5f6f4');
          try { localStorage.setItem("rl-field-guide-theme", next); } catch {}
        });
      });
      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        const isDark = document.documentElement.dataset.theme === "dark";
        button.setAttribute("aria-pressed", String(isDark));
        const label = isDark ? button.dataset.lightLabel : button.dataset.darkLabel;
        if (label) { button.setAttribute("aria-label", label); button.textContent = label; }
      });
      document.addEventListener("click", (event) => {
        const anchor = event.target instanceof Element ? event.target.closest("[data-heading-anchor]") : null;
        if (!(anchor instanceof HTMLAnchorElement)) return;
        const url = new URL(anchor.href);
        try {
          navigator.clipboard?.writeText(url.toString());
          anchor.dataset.copied = "true";
          window.setTimeout(() => { delete anchor.dataset.copied; }, 1200);
        } catch {}
      });
    </script>
  </body>
</html>
